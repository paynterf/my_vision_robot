[Unit]
Description=WallE clearest-direction vision node
After=network-online.target walle-camera.service
Wants=network-online.target walle-camera.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/my_vision_robot
ExecStart=/bin/bash -lc 'source /home/pi/my_vision_robot/software/ros2/install/setup.bash && python3 /home/pi/my_vision_robot/software/scripts/clearest_direction_node.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target