[Unit]
Description=WallE_5 supervisor (serial, camera, auto-nav)
After=network-online.target walle-vision.service
Wants=walle-vision.service

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/my_vision_robot
Environment=HOME=/home/pi
ExecStartPre=/bin/sleep 8
ExecStart=/bin/bash -lc 'source /home/pi/my_vision_robot/software/ros2/install/setup.bash && python3 /home/pi/my_vision_robot/software/scripts/WallE_5.py'
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target